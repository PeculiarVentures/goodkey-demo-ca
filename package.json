{
  "name": "goodkey-demo-ca",
  "version": "1.0.0",
  "private": true,
  "description": "A demo Certificate Authority (CA) interface for easy digital certificate issuance and management based on CSRs.",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "type": "module",
  "scripts": {
    "start": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --port 8000",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@peculiar/asn1-csr": "^3.0.0",
    "@peculiar/asn1-schema": "^3.0.0",
    "@peculiar/asn1-x509": "^3.0.0",
    "@peculiar/ssh": "^3.0.0",
    "@peculiar/x509": "^3.1.0",
    "notistack": "^3.0.2",
    "pvtsutils": "^1.3.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
